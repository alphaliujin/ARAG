# =============================================================================
# ARAG 敏感信息识别系统 - .gitignore
# 原则: 只忽略 生成物 / 大文件 / 本地环境 / 运行时数据;
#       源码(backend, MD2RAG, X2MD, UI/src)、配置(*.conf)、输入语料(DOC/) 入库。
# =============================================================================

# ---- Python: 字节码 / 缓存 / 打包产物 ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- 虚拟环境 ----
.venv/
venv/
env/
ENV/

# ---- Node.js / React 前端 ----
# node_modules/ 与 build/ 通配,同时覆盖 UI/node_modules、UI/build
node_modules/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- 本地大模型 (体积巨大, 不入库; 各自按需下载放置到项目根目录) ----
# bge-m3 ~4.3G / clip-vit-large-patch14 ~6.4G / bge-reranker-v2-m3 ~568M
bge-m3-local/
clip-vit-large-patch14-local/
bge-reranker-v2-m3-local/

# ---- 向量数据库 (ChromaDB, 运行时生成) ----
vector_db/
vector_db_backup_*/
data/

# ---- 源文档语料 (含敏感信息, 不上传到 GitHub) ----
# DOC/ : 各密级源文档 (0Public / 1Restricted / 2Confidential), 系统输入语料
#        注: DOC_meta/ 是另一目录 (项目说明文档), 仍入库, 不受此规则影响
DOC/

# ---- 运行时生成的数据与产物 (均可由流程重跑生成, 不入库) ----
# MD/            : X2MD 预处理输出, 由 DOC/ 生成
# DocScan/       : 待检文件上传 + 切片 JSON + 嵌入向量
# dedup_results/ : 去重比对结果 (Markdown / JSON / 删除备份)
MD/
DocScan/
dedup_results/

# ---- 运行时设置 (含本机绝对路径, 由 SettingsService 启动时读写) ----
runtime_settings.json

# ---- 日志 ----
# *.log 匹配 backend.log / frontend.log
# *.log.* 匹配 backend.log.prev / frontend.log.prev (日志轮转备份)
*.log
*.log.*

# ---- 发布归档 ----
*.tar.gz
*.zip

# ---- 敏感配置 / 本地凭证 ----
.env
.env.*
!.env.example
!.env.production

# ---- 编辑器 / 操作系统 ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
